#!/bin/sh
# The commit gate (scripts/gate.py): a recorded pass of the staged tree, or the quick suite run on it.
# Enabled by: git config core.hooksPath scripts/hooks
top=$(git rev-parse --show-toplevel) || exit 1
python="$(git rev-parse --path-format=absolute --git-common-dir)/../.venv/bin/python"
[ -x "$python" ] || python=python3
exec "$python" "$top/scripts/gate.py" hook
